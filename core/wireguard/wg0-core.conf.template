# wg0-core.conf.template
# WireGuard server config for the regional core. Render with operator
# substitutions for {{SERVER_PRIVATE_KEY}} and the per-vehicle peer list.

[Interface]
Address    = 10.252.0.1/24
ListenPort = 51820
PrivateKey = {{SERVER_PRIVATE_KEY}}
SaveConfig = false

# --- Per-vehicle peers ---
# Each peer block is one K430. Add one block per enrolled vehicle.
#
# [Peer]
# # vehicle-id: {{VEHICLE_ID}}
# PublicKey  = {{VEHICLE_PUBLIC_KEY}}
# AllowedIPs = 10.252.0.{{VEHICLE_OCTET}}/32
