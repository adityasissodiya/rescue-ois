\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces AAL linearization-boundary/state-class partition. M1 places the single-writer authority boundary at the command edge: command decisions are serialized into the incident journal by M2 with command-assigned \textit  {event\_seq}. Outside the boundary, reference/artifact data, responder outboxes, and materialized views use local/eventual contracts for R1/R2; M3 forwards durable, idempotent field observations across the boundary, becoming authoritative only after command acceptance. M4 moves the boundary by fenced operator promotion, so the boundary is set by operational command rather than Raft-style reachability or CRDT-style merge.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:linearization-boundary}{{2}{3}{AAL linearization-boundary/state-class partition. M1 places the single-writer authority boundary at the command edge: command decisions are serialized into the incident journal by M2 with command-assigned \textit {event\_seq}. Outside the boundary, reference/artifact data, responder outboxes, and materialized views use local/eventual contracts for R1/R2; M3 forwards durable, idempotent field observations across the boundary, becoming authoritative only after command acceptance. M4 moves the boundary by fenced operator promotion, so the boundary is set by operational command rather than Raft-style reachability or CRDT-style merge}{figure.2}{}}
\newlabel{fig:linearization-boundary@cref}{{[figure][2][]2}{[1][3][]3}}
