\newlabel{sec:protocol-m2}{{\mbox  {III-C}}{4}{Incident Journal Sequencing (M2)}{subsection.3.3}{}}
\newlabel{sec:protocol-m2@cref}{{[subsection][3][3]\mbox  {III-C}}{[1][4][]4}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces M2 incident-journal sequencing. The command edge accepts each \textit  {client\_event\_id} once and assigns \textit  {event\_seq} atomically with journal insertion, producing a totally ordered log; a duplicate \textit  {client\_event\_id} folds onto its existing entry rather than taking a new sequence number. Consumers replay in \textit  {event\_seq} order, and materialized state is rebuildable from the journal.}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:journal-sequencing}{{4}{4}{M2 incident-journal sequencing. The command edge accepts each \textit {client\_event\_id} once and assigns \textit {event\_seq} atomically with journal insertion, producing a totally ordered log; a duplicate \textit {client\_event\_id} folds onto its existing entry rather than taking a new sequence number. Consumers replay in \textit {event\_seq} order, and materialized state is rebuildable from the journal}{figure.4}{}}
\newlabel{fig:journal-sequencing@cref}{{[figure][4][]4}{[1][4][]4}}
