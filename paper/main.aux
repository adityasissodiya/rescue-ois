\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Tiered edge topology. The regional core holds master/reference data and receives backhaul; vehicle edges run local services, with the command edge owning the append-only incident journal and responder edges queuing submissions; tablets are leaf clients. The mesh between vehicles is routed transit, not a consistency mechanism, and user VLANs are not extended across vehicles.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:tiered-topology}{{3}{4}{Tiered edge topology. The regional core holds master/reference data and receives backhaul; vehicle edges run local services, with the command edge owning the append-only incident journal and responder edges queuing submissions; tablets are leaf clients. The mesh between vehicles is routed transit, not a consistency mechanism, and user VLANs are not extended across vehicles}{figure.3}{}}
\newlabel{fig:tiered-topology@cref}{{[figure][3][]3}{[1][4][]4}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {III-B}}Tiered Edge Topology}{4}{subsection.3.2}\protected@file@percent }
